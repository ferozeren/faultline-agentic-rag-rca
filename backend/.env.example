HISTORICAL_INCIDENTS_PATH=backend/data/historical_incidents/raw/incidentdb.csv
API_VERSION=1.0.0
# Comma-separated browser origins; leave empty to disable cross-origin access.
CORS_ALLOWED_ORIGINS=
RAG_CHUNK_SIZE=224
RAG_CHUNK_OVERLAP=40
RAG_EMBEDDING_MAX_TOKENS=256
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_LOCAL_FILES_ONLY=false
RAG_CHUNKS_PATH=data/processed/cleaned_documents_chunks.jsonl

# Existing NVIDIA NIM chat model settings.
NVIDIA_MODEL=
NVIDIA_API_KEY=

# Prometheus API URL. For Grafana Cloud, use the Prometheus data source URL.
PROMETHEUS_URL=
# Grafana Cloud uses this token as the HTTP Basic auth password with PROMETHEUS_USERNAME.
# Other Prometheus endpoints can use it as an HTTP Bearer token when username is empty.
PROMETHEUS_BEARER_TOKEN=
PROMETHEUS_USERNAME=

# Grafana instance root URL; include any reverse-proxy subpath (for example /grafana).
GRAFANA_URL=
# Grafana service-account token with read access to dashboards and alerting APIs.
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# PostgreSQL connection. DATABASE_URL takes precedence when set.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=incident_investigator
POSTGRES_USER=incident_investigator
POSTGRES_PASSWORD=
DATABASE_URL=
